# App
NODE_ENV=development
PORT=3000
# Comma-separated browser origins allowed by CORS.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# PostgreSQL
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=indexer

# Seed chain (used only when `chains` table is empty)
HYPEREVM_RPC_URL=https://your-hyperEVM-rpc
# Comma-separated. Seeded into chain_rpc_endpoints and used when the primary RPC fails.
HYPEREVM_RPC_URL_FALLBACK=
CHAIN_ID=999
CHAIN_NAME=HyperEVM

# Seed token (used only when `tokens` table is empty; metadata verified on-chain)
TOKEN_ADDRESS=0x07c57E32a3C29D5659bda1d3EFC2E7BF004E3035

# Sync
SYNC_ENABLED=true
SYNC_LOOKBACK_DAYS=7
# Unix seconds. Empty holder history reports no transactions since this time minus SYNC_LOOKBACK_DAYS.
DAY_APP_DEPLOY=1791647520
SYNC_BLOCK_RANGE=100
SYNC_CONFIRMATION_DEPTH=12
SYNC_POLL_INTERVAL_MS=8000
SYNC_RETRY_MAX_ATTEMPTS=5
SYNC_RETRY_BASE_DELAY_MS=2000
